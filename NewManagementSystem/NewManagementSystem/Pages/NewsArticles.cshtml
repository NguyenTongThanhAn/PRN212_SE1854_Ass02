@page
@model NewsArticlesModel
@{
ViewData["Title"] = "News Articles";
Layout = "Shared/_Layout";
}

<div class="container my-5">
    @if (Model.Articles != null && Model.Articles.Count > 0)
    {
    var featured = Model.Articles.First();
    var allOthers = Model.Articles.Skip(1).ToList();

    var gridArticles = allOthers.Take(6).ToList();
    var remaining = allOthers.Skip(6).ToList();

    <!-- SignalR inserted featured -->
    <div id="create-container"></div>

    <!-- Featured article -->
    <div class="row mb-5" data-article-id="@featured.NewsArticleId" data-article-type="featured">
        <div class="col-md-7">
            <img src="@featured.ImageUrl" class="img-fluid rounded" alt="Featured image" style="object-fit: cover; max-height: 400px;" />
        </div>
        <div class="col-md-5 d-flex flex-column justify-content-center">
            <h2 class="text-danger">@featured.Headline</h2>
            <p class="text-muted">
                @(featured.CreatedBy?.AccountName ?? "Unknown")
                • @featured.CreatedDate?.ToString("MMM dd, yyyy")
            </p>
            <p>@(featured.NewsContent?.Split('.').FirstOrDefault() ?? "No content.")</p>
            <a href="/detail/@featured.NewsArticleId" class="btn btn-dark btn-sm w-auto">Read Full Article</a>
        </div>
    </div>

    <!-- Grid articles (next 6) -->
    <div class="row">
        <div class="col-md-6">
            @for (int i = 0; i < 3 && i < gridArticles.Count; i++)
            {
            var article = gridArticles[i];
            <div class="d-flex mb-4 border-bottom pb-3" data-article-id="@article.NewsArticleId" data-article-type="grid">
                <img src="@article.ImageUrl" class="me-3" style="width: 100px; height: 70px; object-fit: cover;" alt="Thumb" />
                <div>
                    <h6 class="mb-1 text-dark">@article.Headline</h6>
                    <p class="text-muted small mb-1">
                        @(article.CreatedBy?.AccountName ?? "Unknown")
                        • @article.CreatedDate?.ToString("MMM dd, yyyy")
                    </p>
                    <a href="/detail/@article.NewsArticleId" class="text-decoration-none small">Read More →</a>
                </div>
            </div>
            }
        </div>
        <div class="col-md-6">
            @for (int i = 3; i < 6 && i < gridArticles.Count; i++)
            {
            var article = gridArticles[i];
            <div class="d-flex mb-4 border-bottom pb-3" data-article-id="@article.NewsArticleId" data-article-type="grid">
                <img src="@article.ImageUrl" class="me-3" style="width: 100px; height: 70px; object-fit: cover;" alt="Thumb" />
                <div>
                    <h6 class="mb-1 text-dark">@article.Headline</h6>
                    <p class="text-muted small mb-1">
                        @(article.CreatedBy?.AccountName ?? "Unknown")
                        • @article.CreatedDate?.ToString("MMM dd, yyyy")
                    </p>
                    <a href="/detail/@article.NewsArticleId" class="text-decoration-none small">Read More →</a>
                </div>
            </div>
            }
        </div>
    </div>

    <!-- More articles -->
    @if (remaining.Count > 0)
    {
    <hr class="my-5" />
    <h3 class="mb-4">More for you</h3>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var article in remaining)
        {
        <div class="col" data-article-id="@article.NewsArticleId" data-article-type="card">
            <div class="card h-100 shadow-sm border-0">
                <img class="card-img-top" src="@article.ImageUrl" style="height: 180px; object-fit: cover;" alt="More news" />
                <div class="card-body">
                    <h6 class="card-title text-primary">@article.Headline</h6>
                    <p class="card-text small">@article.NewsContent?.Split('.').FirstOrDefault()</p>
                    <p class="text-muted small">
                        @(article.CreatedBy?.AccountName ?? "Unknown")
                        • @article.CreatedDate?.ToString("MMM dd, yyyy")
                    </p>
                    <a href="/detail/@article.NewsArticleId" class="btn btn-sm btn-outline-primary">Read</a>
                </div>
            </div>
        </div>
        }
    </div>
    }
    }
    else
    {
    <p class="text-muted">No articles found.</p>
    }
</div>

@section Scripts {
<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder().withUrl("/articlesHub").build();

    connection.on("ReceiveNewArticle", function (article) {
        console.log(article);
        if (article.newsStatus) insertArticleCard(article);
    });

    connection.on("ReceiveUpdatedArticle", function (article) {
        console.log(article);
        if (article.newsStatus) {
            const existingCard = document.querySelector(`[data-article-id="${article.newsArticleId}"]`);
            if (existingCard) {
                updateArticleCard(article);
            } else {
                insertArticleCard(article);
            }
        } else {
            deleteArticleCard(article);
        }
    });

    connection.on("ReceiveDeletedArticle", function (article) {
        deleteArticleCard(article);
    });

    connection.start().then(() => console.log("SignalR Connected"));

    function createFeaturedCardHTML(article) {
        return `
        <div class="row mb-5" data-article-id="${article.newsArticleId}" data-article-type="featured">
            <div class="col-md-7">
                <img src="${article.imageUrl || '#'}" class="img-fluid rounded" alt="Featured image" style="object-fit: cover; max-height: 400px;" />
            </div>
            <div class="col-md-5 d-flex flex-column justify-content-center">
                <h2 class="text-danger">${article.headline}</h2>
                <p class="text-muted">${article.accountName || 'Unknown'} • ${new Date(article.createdDate).toLocaleDateString()}</p>
                <p>${article.newsContent?.split('.')[0] || 'No content'}</p>
                <a href="/detail/${article.newsArticleId}" class="btn btn-dark btn-sm w-auto">Read Full Article</a>
            </div>
        </div>`;
    }

    function createGridCardHTML(article) {
        return `
        <div class="d-flex mb-4 border-bottom pb-3" data-article-id="${article.newsArticleId}" data-article-type="grid">
            <img src="${article.imageUrl || '#'}" class="me-3" style="width: 100px; height: 70px; object-fit: cover;" alt="Thumb" />
            <div>
                <h6 class="mb-1 text-dark">${article.headline}</h6>
                <p class="text-muted small mb-1">${article.accountName || 'Unknown'} • ${new Date(article.createdDate).toLocaleDateString()}</p>
                <a href="/detail/${article.newsArticleId}" class="text-decoration-none small">Read More →</a>
            </div>
        </div>`;
    }

    function createCardHTML(article) {
        return `
        <div class="col" data-article-id="${article.newsArticleId}" data-article-type="card">
            <div class="card h-100 shadow-sm border-0">
                <img class="card-img-top" src="${article.imageUrl || '#'}" style="height: 180px; object-fit: cover;" alt="More news" />
                <div class="card-body">
                    <h6 class="card-title text-primary">${article.headline}</h6>
                    <p class="card-text small">${article.newsContent?.split('.')[0] || 'No content'}</p>
                    <p class="text-muted small">${article.accountName || 'Unknown'} • ${new Date(article.createdDate).toLocaleDateString()}</p>
                    <a href="/detail/${article.newsArticleId}" class="btn btn-sm btn-outline-primary">Read</a>
                </div>
            </div>
        </div>`;
    }

    function updateArticleCard(article) {
        const allCards = document.querySelectorAll(`[data-article-id="${article.newsArticleId}"]`);
        allCards.forEach(card => {
            const type = card.getAttribute("data-article-type");
            const temp = document.createElement("div");

            if (type === "featured") temp.innerHTML = createFeaturedCardHTML(article);
            else if (type === "grid") temp.innerHTML = createGridCardHTML(article);
            else temp.innerHTML = createCardHTML(article);

            card.replaceWith(temp.firstElementChild);
        });
    }

    function insertArticleCard(article) {
        const container = document.getElementById("create-container");
        if (container) {
            const temp = document.createElement("div");
            temp.innerHTML = createFeaturedCardHTML(article);
            container.prepend(temp.firstElementChild);
        }
    }

    function deleteArticleCard(article) {
        const cards = document.querySelectorAll(`[data-article-id="${article.newsArticleId}"]`);
        cards.forEach(c => c.remove());
    }
</script>
}
