@page
@model NewManagementSystem.Pages.Categories
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Categories";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="text-end mb-3">
    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
        <i class="bi bi-plus-circle"></i> Create Category
    </button>
</div>

@if (Model.Category.Count == 0)
{
    <div class="alert alert-secondary text-center">There is no category here.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var category in Model.Category)
        {
            <div class="col">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@category.CategoryName</h5>
                            <span class="badge @(category.IsActive ? "bg-success" : "bg-secondary")">
                                @(category.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                        <p class="card-text text-muted flex-grow-1">@category.CategoryDesciption</p>

                        <div class="d-flex justify-content-end gap-2 pt-3">
                            <button class="btn btn-sm btn-warning" onclick="openEditModal(@category.CategoryId)">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            @if (!Model.CategoryHasArticle.ContainsKey(category.CategoryId) || !Model.CategoryHasArticle[category.CategoryId])
                            {
                                <button class="btn btn-sm btn-danger" onclick="openDeleteModal(@category.CategoryId)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Create Category Modal -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title">Create Category</h5>
                    <button class="btn-close" type="button" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="NewCategory.CategoryName" class="form-label"></label>
                        <input asp-for="NewCategory.CategoryName" class="form-control" required />
                        <span asp-validation-for="NewCategory.CategoryName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCategory.CategoryDesciption" class="form-label"></label>
                        <input asp-for="NewCategory.CategoryDesciption" class="form-control" />
                        <span asp-validation-for="NewCategory.CategoryDesciption" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCategory.IsActive" class="form-label"></label>
                        <select asp-for="NewCategory.IsActive" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Category Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow">
            <form method="post" asp-page-handler="Edit">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Category</h5>
                    <button class="btn-close" type="button" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="EditCategory.CategoryId" id="editCategoryId" />
                    <div class="mb-3">
                        <label asp-for="EditCategory.CategoryName" class="form-label"></label>
                        <input asp-for="EditCategory.CategoryName" class="form-control" id="editCategoryName" required />
                        <span asp-validation-for="EditCategory.CategoryName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditCategory.CategoryDesciption" class="form-label"></label>
                        <input asp-for="EditCategory.CategoryDesciption" class="form-control" id="editCategoryDesciption" />
                        <span asp-validation-for="EditCategory.CategoryDesciption" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EditCategory.IsActive" class="form-label"></label>
                        <select asp-for="EditCategory.IsActive" class="form-select" id="editCategoryIsActive">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-warning" type="submit">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Category Modal -->
<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-labelledby="deleteCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow">
            <form method="post" asp-page-handler="Delete">
                <input type="hidden" asp-for="DeleteCategoryId" id="deleteCategoryId" />
                <div class="modal-header">
                    <h5 class="modal-title">Delete Category</h5>
                    <button class="btn-close" type="button" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Are you sure you want to delete this category?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger" type="submit">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openEditModal(categoryId) {
            fetch(`?handler=Category&id=${categoryId}`)
                .then(response => response.json())
                .then(data => {
                    document.getElementById('editCategoryId').value = data.categoryId;
                    document.getElementById('editCategoryName').value = data.categoryName;
                    document.getElementById('editCategoryDesciption').value = data.categoryDesciption;
                    document.getElementById('editCategoryIsActive').value = data.isActive;
                    new bootstrap.Modal(document.getElementById('editCategoryModal')).show();
                });
        }

        function openDeleteModal(categoryId) {
            document.getElementById('deleteCategoryId').value = categoryId;
            new bootstrap.Modal(document.getElementById('deleteCategoryModal')).show();
        }
    </script>
}
