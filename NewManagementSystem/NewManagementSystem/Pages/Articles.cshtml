@page
@model ArticlesModel

@{
    Layout = "Shared/_Layout";
    ViewData["title"] = "Articles";
}


<h1>@ViewData["Title"]</h1>

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
    Create New Article
</button>
<!-- Create modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">Create New Article </h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="Create" enctype="multipart/form-data">
                    <div class="mb-3">
                        <input type="text" class="form-control" id="news-title" name="ArticlesRequest.NewsTitle"
                               placeholder="Title" value="@(Model.ArticlesRequest?.NewsTitle ?? "")">
                        <span asp-validation-for="ArticlesRequest.NewsTitle" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <input type="text" class="form-control" id="headline" name="ArticlesRequest.Headline"
                               placeholder="Headline" value="@(Model.ArticlesRequest?.Headline ?? "")">
                        <span asp-validation-for="ArticlesRequest.Headline" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <textarea class="form-control" id="news-content" name="ArticlesRequest.NewsContent"
                                  placeholder="Content">@(Model.ArticlesRequest?.NewsContent ?? "")</textarea>
                        <span asp-validation-for="ArticlesRequest.NewsContent" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <input type="text" class="form-control" id="news-source" name="ArticlesRequest.NewsSource"
                               placeholder="Source" value="@(Model.ArticlesRequest?.NewsSource ?? "")">
                        <span asp-validation-for="ArticlesRequest.NewsSource" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <select class="form-select form-select-sm" name="ArticlesRequest.CategoryId"
                                aria-label="Small select example">
                            <option selected disabled>--Category--</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId"
                                        selected="@(Model.ArticlesRequest?.CategoryId == category.CategoryId)">@category.CategoryName</option>
                            }
                        </select>
                        <span asp-validation-for="ArticlesRequest.CategoryId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <select class="form-select form-select-sm" id="news-status" name="ArticlesRequest.NewsStatus"
                                aria-label="Status select">
                            <option selected disabled>--Status--</option>
                            <option value="True"
                                    selected="@(Model.ArticlesRequest?.NewsStatus == true ? "selected" : "")">Published
                            </option>
                            <option value="False"
                                    selected="@(Model.ArticlesRequest?.NewsStatus == false ? "selected" : "")">Private
                            </option>
                        </select>
                        <span asp-validation-for="ArticlesRequest.NewsStatus" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <input type="file" class="form-control" name="ArticlesRequest.ImageUrl" accept="image/*"
                               placeholder="Upload Image">
                        <span asp-validation-for="ArticlesRequest.ImageUrl" class="text-danger"></span>
                    </div>
                    <div class="mb-3 d-flex flex-wrap justify-content-center">
                        @{ var i = 0; }
                        @foreach (var tag in Model.Tags)
                        {
                            <div class="me-3 mb-2" style="flex: 0 0 auto; width: calc(20% - 1rem);">
                                <input class="form-check-input" type="checkbox" value="@tag.TagId"
                                       id="tag-@tag.TagId" name="ArticlesRequest.Tags"
                                       @(Model.ArticlesRequest?.Tags?.Contains(tag.TagId) == true ? "checked" : "")>
                                <label class="form-check-label" for="tag-@tag.TagId">@tag.TagName</label>
                            </div>
                            i++;
                            if (i % 4 == 0)
                            {
                                <div class="w-100"></div>
                            }
                        }
                        <span asp-validation-for="ArticlesRequest.Tags" class="text-danger"></span>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Edit Article </h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-page-handler="Edit" enctype="multipart/form-data">
                    <div>
                        <input type="hidden" class="form-control" id="edit-id" name="EditArticlesRequest.NewsArticleId">
                        <span asp-validation-for="EditArticlesRequest.NewsArticleId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <input type="text" class="form-control" id="edit-title" name="EditArticlesRequest.NewsTitle"
                               placeholder="Title">
                        <span asp-validation-for="EditArticlesRequest.NewsTitle" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <input type="text" class="form-control" id="edit-headline" name="EditArticlesRequest.Headline"
                               placeholder="Headline">
                        <span asp-validation-for="EditArticlesRequest.Headline" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <textarea class="form-control" id="edit-content" name="EditArticlesRequest.NewsContent"
                                  placeholder="Content"></textarea>
                        <span asp-validation-for="EditArticlesRequest.NewsContent" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <input type="text" class="form-control" id="edit-source" name="EditArticlesRequest.NewsSource"
                               placeholder="Source">
                        <span asp-validation-for="EditArticlesRequest.NewsSource" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <select class="form-select form-select-sm" id="edit-category"
                                name="EditArticlesRequest.CategoryId" aria-label="Small select example">
                            <option selected disabled>--Category--</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                        <span asp-validation-for="EditArticlesRequest.CategoryId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <select class="form-select form-select-sm" id="edit-status"
                                name="EditArticlesRequest.NewsStatus" aria-label="Status select">
                            <option selected disabled>--Status--</option>
                            <option value="True">Published</option>
                            <option value="False">Private</option>
                        </select>
                        <span asp-validation-for="EditArticlesRequest.NewsStatus" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <input type="file" class="form-control" id="image-file" name="EditArticlesRequest.ImageUrl"
                               accept="image/*" placeholder="Upload Image">
                        @* <span asp-validation-for="EditArticlesRequest.ImageUrl" class="text-danger"></span> *@
                    </div>
                    <div class="mb-3 d-flex flex-wrap justify-content-center">
                        @{var i = 0; }
                        @foreach (var tag in Model.Tags)
                        {
                            <div class="me-3 mb-2" style="flex: 0 0 auto; width: calc(20% - 1rem);">
                                <input class="form-check-input" type="checkbox"
                                       id="edit-tag-@tag.TagId"
                                       name="EditArticlesRequest.Tags"
                                       value="@tag.TagId"/>
                                <label class="form-check-label" for="edit-tag-@tag.TagId">@tag.TagName</label>
                            </div>
                            i++;
                            if (i % 4 == 0)
                            {
                                <div class="w-100"></div>
                            }
                        }
                        <span asp-validation-for="EditArticlesRequest.Tags" class="text-danger"></span>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Edit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this article?</p>
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" id="deleteArticleId" name="ArticleIdToDelete"/>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div>
    @if (Model.Articles.Count == 0)
    {
        <p class="text-muted">No articles are currently published.</p>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead class="thead-dark">
            <tr>
                <th>Thumbnail</th>
                <th>Title</th>
                <th>Category</th>
                <th>Author</th>
                <th>Source</th>
                <th>Created Date</th>
                <th>Updated Date</th>
                <th>Status</th>
                <th>Tags</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody id="articlesTableBody">
            @* Các row bài viết *@
            </tbody>
            <tbody>
            @foreach (var article in Model.Articles)
            {
                <tr id="article-row-@(article.NewsArticleId)">
                    <td>
                        <img src="@(string.IsNullOrEmpty(article.ImageUrl) ? "/images/no-image.png" : article.ImageUrl)"
                             alt="N/A" class="img-thumbnail" width="100"/>
                    </td>
                    <td>@article.NewsTitle</td>
                    <td>@article.Category.CategoryName</td>
                    <td>@article.CreatedBy.AccountName</td>
                    <td>@(article.NewsSource)</td>
                    <td>@(article.CreatedDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                    <td>@(article.ModifiedDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                    <td>@(article.NewsStatus ? "Published" : "Private")</td>
                    <td>
                        @if (article.Tags != null && article.Tags.Any())
                        {
                            @string.Join(", ", article.Tags.Select(t => t.TagName))
                        }
                    </td>
                    <td>
                        <a asp-page="/Articles/Details" asp-route-id="@article.NewsArticleId"
                           class="btn btn-sm btn-info">View</a>
                        <button type="button"
                                class="btn btn-warning btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#editModal"
                                data-id="@article.NewsArticleId"
                                data-title="@article.NewsTitle"
                                data-headline="@article.Headline"
                                data-content="@article.NewsContent"
                                data-source="@article.NewsSource"
                                data-category="@article.CategoryId"
                                data-status="@article.NewsStatus"
                                data-tags="@string.Join(",", article.Tags.Select(t => t.TagId))">
                            Edit
                        </button>

                        <button type="button"
                                class="btn btn-danger btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@article.NewsArticleId">
                            Delete
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script>
        function openEditModal(data) {
            document.getElementById('edit-id').value = data.id;
            document.getElementById('edit-title').value = data.title;
            document.getElementById('edit-headline').value = data.headline;
            document.getElementById('edit-content').value = data.content;
            document.getElementById('edit-source').value = data.source;
            document.getElementById('edit-category').value = data.category;
            document.getElementById('edit-status').value = data.status === 'True' ? 'True' : 'False';

            const tagIds = (data.tags || '')
                .split(',')
                .map(id => parseInt(id))
                .filter(id => !isNaN(id));

            setTimeout(() => {
                document.querySelectorAll('#editModal input[name="EditArticlesRequest.Tags"]').forEach(cb => {
                    cb.checked = tagIds.includes(parseInt(cb.value));
                });
            }, 100);

            const modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }

        $(document).ready(function () {
            const showCreateModal = '@ViewData["ShowCreateModal"]';
            if (showCreateModal === 'True') {
                const modal = new bootstrap.Modal(document.getElementById('createModal'));
                modal.show();
            }

            const showEditModal = '@ViewData["ShowEditModal"]';
            if (showEditModal === 'True') {
                const modalData = {
                    id: '@Model.EditArticlesRequest?.NewsArticleId',
                    title: '@Model.EditArticlesRequest?.NewsTitle',
                    headline: '@Model.EditArticlesRequest?.Headline',
                    content: '@Model.EditArticlesRequest?.NewsContent',
                    source: '@Model.EditArticlesRequest?.NewsSource',
                    category: '@Model.EditArticlesRequest?.CategoryId',
                    status: '@Model.EditArticlesRequest?.NewsStatus.ToString().ToLower()',
                    tags: '@string.Join(",", Model.EditArticlesRequest?.Tags ?? new List<int>())'
                };
                openEditModal(modalData);
            }
        });

        document.getElementById('editModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const data = {
                id: button.getAttribute('data-id'),
                title: button.getAttribute('data-title'),
                headline: button.getAttribute('data-headline'),
                content: button.getAttribute('data-content'),
                source: button.getAttribute('data-source'),
                category: button.getAttribute('data-category'),
                status: button.getAttribute('data-status'),
                tags: button.getAttribute('data-tags')
            };
            openEditModal(data);
        });

        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const articleId = button.getAttribute('data-id');
            document.getElementById('deleteArticleId').value = articleId;
        });

        // SignalR Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/articlesHub")
            .build();

        connection.on("ReceiveNewArticle", function (article) {
            console.log("New article received:", article);
            const tbody = document.getElementById("articlesTableBody");
            if (tbody) {
                // Thêm bài viết mới lên đầu bảng
                tbody.insertAdjacentHTML('afterbegin', createArticleRow(article));
            }});

        connection.on("ReceiveUpdatedArticle", function (article) {
            console.log("Article updated:", article);
            updateArticleRow(article);
        });

        connection.on("ReceiveDeletedArticle", function (article) {
            console.log("Article deleted:", article);
            deleteArticleRow(article);
        });

        connection.start()
            .then(function () {
                console.log("SignalR Connected");
            })
            .catch(function (err) {
                console.error("SignalR Connection Error:", err);
            });

        function createArticleRow(article) {
            // Tạo row html cho article mới
            console.log("createArticleRow", article);
            const tags = (article.tags || []).map(t => t.tagName).join(", ");
            const statusText = article.newsStatus ? "Published" : "Private";
            const createdDate = article.createdDate ? new Date(article.createdDate).toLocaleDateString() : "N/A";
            const updatedDate = article.modifiedDate ? new Date(article.modifiedDate).toLocaleDateString() : "N/A";
            const imageUrl = article.imageUrl && article.imageUrl.trim() !== "" ? article.imageUrl : "/images/no-image.png";

            return `
        <tr id="article-row-${article.newsArticleId}">
            <td><img src="${imageUrl}" alt="N/A" class="img-thumbnail" width="100"/></td>
            <td>${article.newsTitle}</td>
            <td>${article.categoryName || ""}</td>
            <td>${article.accountName || ""}</td>
            <td>${article.newsSource || ""}</td>
            <td>${createdDate}</td>
            <td>${updatedDate}</td>
            <td>${statusText}</td>
            <td>${tags}</td>
            <td>
                <a href="/Articles/Details?id=${article.newsArticleId}" class="btn btn-sm btn-info">View</a>
                <button type="button" class="btn btn-warning btn-sm"
                    data-bs-toggle="modal" data-bs-target="#editModal"
                    data-id="${article.newsArticleId}"
                    data-title="${article.newsTitle}"
                    data-headline="${article.headline}"
                    data-content="${article.newsContent}" 
                    data-source="${article.newsSource}"
                    data-category="${article.categoryId}"
                    data-status="${article.newsStatus}"
                    data-tags="${(article.tags || []).map(t => t.tagId).join(',')}">
                    Edit
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                    data-id="${article.newsArticleId}">
                    Delete
                </button>
            </td>
        </tr>
    `;
        }

        function updateArticleRow(article) {
            const row = document.getElementById(`article-row-${article.newsArticleId}`);
            
            if (!row) return;
            
            const tags = (article.tags || []).map(t => t.tagName).join(", ");
            const statusText = article.newsStatus ? "Published" : "Private";
            const createdDate = article.createdDate ? new Date(article.createdDate).toLocaleDateString() : "N/A";
            const updatedDate = article.modifiedDate ? new Date(article.modifiedDate).toLocaleDateString() : "N/A";
            const imageUrl = article.imageUrl && article.ImageUrl.trim() !== "" ? article.ImageUrl : "/images/no-image.png";

            row.innerHTML = `
        <td><img src="${imageUrl}" alt="N/A" class="img-thumbnail" width="100"/></td>
        <td>${article.newsTitle}</td>
        <td>${article.categoryName || ""}</td>
        <td>${article.accountName || ""}</td>
        <td>${article.newsSource || ""}</td>
        <td>${createdDate}</td>
        <td>${updatedDate}</td>
        <td>${statusText}</td>
        <td>${tags}</td>
        <td>
            <a href="/Articles/Details?id=${article.newsArticleId}" class="btn btn-sm btn-info">View</a>
            <button type="button" class="btn btn-warning btn-sm"
                data-bs-toggle="modal" data-bs-target="#editModal"
                data-id="${article.newsArticleId}"
                data-title="${article.newsTitle}"
                data-headline="${article.headline}"
                data-content="${article.newsContent}"
                data-source="${article.newsSource}"
                data-category="${article.CategoryId}"
                data-status="${article.newsStatus}"
                data-tags="${(article.tags || []).map(t => t.tagName).join(',')}">
                Edit
            </button>
            <button type="button" class="btn btn-danger btn-sm"
                data-bs-toggle="modal" data-bs-target="#deleteModal"
                data-id="${article.newsArticleId}">
                Delete
            </button>
        </td>
    `;
        }

        function deleteArticleRow(article) {
            const row = document.getElementById(`article-row-${article.newsArticleId}`);
            if (!row) return;

            const tags = (article.tags || []).map(t => t.tagName).join(", ");
            const statusText = article.newsStatus ? "Published" : "Private";
            const createdDate = article.createdDate ? new Date(article.createdDate).toLocaleDateString() : "N/A";
            const updatedDate = article.modifiedDate ? new Date(article.modifiedDate).toLocaleDateString() : "N/A";
            const imageUrl = article.imageUrl && article.ImageUrl.trim() !== "" ? article.ImageUrl : "/images/no-image.png";
            
            row.innerHTML = `
        <td><img src="${imageUrl}" alt="N/A" class="img-thumbnail" width="100"/></td>
        <td>${article.newsTitle}</td>
        <td>${article.categoryName || ""}</td>
        <td>${article.accountName || ""}</td>
        <td>${article.newsSource || ""}</td>
        <td>${createdDate}</td>
        <td>${updatedDate}</td>
        <td>${statusText}</td>
        <td>${tags}</td>
        <td>
            <a href="/Articles/Details?id=${article.newsArticleId}" class="btn btn-sm btn-info">View</a>
            <button type="button" class="btn btn-warning btn-sm"
                data-bs-toggle="modal" data-bs-target="#editModal"
                data-id="${article.newsArticleId}"
                data-title="${article.newsTitle}"
                data-headline="${article.headline}"
                data-content="${article.newsContent}"
                data-source="${article.newsSource}"
                data-category="${article.CategoryId}"
                data-status="${article.newsStatus}"
                data-tags="${(article.tags || []).map(t => t.tagName).join(',')}">
                Edit
            </button>
            <button type="button" class="btn btn-danger btn-sm"
                data-bs-toggle="modal" data-bs-target="#deleteModal"
                data-id="${article.newsArticleId}">
                Delete
            </button>
        </td>
    `;
        }

    </script>
}