 @page
    @model DashboardModel
    @{
        ViewData["Title"] = "Dashboard - News Statistics";
    }

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">News Article Dashboard</h2>
            <a href="/SystemAccounts" class="btn btn-outline-secondary">← Back</a>
        </div>

        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-4">
                <label class="form-label">Start Date</label>
                <input type="date" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">End Date</label>
                <input type="date" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-bar-chart-line"></i> Generate Report
                </button>
            </div>
        </form>

        <div class="card shadow-sm p-4">
            <canvas id="chartCanvas" height="100"></canvas>
        </div>
    </div>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const chartData = @Html.Raw(Json.Serialize(Model.ChartPoints));
        console.log(chartData); // check log ra array [{ date: '2024-05-05', totalArticles: 3 }, ...]

        if (chartData.length > 0) {
            new Chart(document.getElementById('chartCanvas'), {
                type: 'bar', // thử đổi bar dễ debug
                data: {
                    labels: chartData.map(d => d.date),
                    datasets: [{
                        label: 'Articles per Day',
                        data: chartData.map(d => d.totalArticles), // 🟢 ĐÚNG TÊN: phải là totalArticles
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.4)',
                        borderWidth: 1,
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        title: {
                            display: true,
                            text: 'Total Articles Created by Day',
                            font: { size: 18 }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Articles'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Date'
                            }
                        }
                    }
                }
            });
        } 
    </script>