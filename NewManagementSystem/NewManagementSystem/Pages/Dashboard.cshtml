 @page
    @model DashboardModel
    @{
        ViewData["Title"] = "Dashboard - News Statistics";
    }
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">News Article Dashboard</h2>
            <a href="/SystemAccounts" class="btn btn-outline-secondary">← Back</a>
        </div>

        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-4">
                <label class="form-label">Start Date</label>
                <input type="date" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">End Date</label>
                <input type="date" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-bar-chart-line"></i> Generate Report
                </button>
            </div>
        </form>

    
    </div>

@if (Model.ShowChart)
{
    <div class="card shadow-sm p-4 mb-4">
        <h5>Articles by Day</h5>
        <canvas id="chartByDay" height="300"></canvas>
    </div>
    <div class="card shadow-sm p-4 mb-4">
        <h5>Articles by Year</h5>
        <canvas id="chartByYear" height="300"></canvas>
    </div>
    <script>
        // Chart by Day
        const chartDataByDay = @Html.Raw(Json.Serialize(Model.ChartPointsByDay));
        if (chartDataByDay.length > 0) {
            new Chart(document.getElementById('chartByDay'), {
                type: 'bar',
                data: {
                    labels: chartDataByDay.map(d => d.date),
                    datasets: [{
                        label: 'Articles per Day',
                        data: chartDataByDay.map(d => d.totalArticles),
                        backgroundColor: 'rgba(13, 110, 253, 0.4)',
                        borderColor: '#0d6efd',
                        borderWidth: 1,
                        barThickness: 60,
                        borderRadius: 10
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        title: { display: true, text: 'Total Articles Created by Day', font: { size: 18 } }
                    },
                    scales: {
                        y: { beginAtZero: true, title: { display: true, text: 'Articles' }, ticks: { stepSize: 1 } },
                        x: { title: { display: true, text: 'Date' }, grid: { display: false } }
                    }
                }
            });
        }

        // Chart by Year
        const chartDataByYear = @Html.Raw(Json.Serialize(Model.ChartPointsByYear));
        if (chartDataByYear.length > 0) {
            new Chart(document.getElementById('chartByYear'), {
                type: 'bar',
                data: {
                    labels: chartDataByYear.map(d => d.date),
                    datasets: [{
                        label: 'Articles per Year',
                        data: chartDataByYear.map(d => d.totalArticles),
                        backgroundColor: 'rgba(40, 167, 69, 0.4)',
                        borderColor: '#28a745',
                        borderWidth: 1,
                        barThickness: 60,
                        borderRadius: 10
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        title: { display: true, text: 'Total Articles Created by Year', font: { size: 18 } }
                    },
                    scales: {
                        y: { beginAtZero: true, title: { display: true, text: 'Articles' }, ticks: { stepSize: 1 } },
                        x: { title: { display: true, text: 'Year' }, grid: { display: false } }
                    }
                }
            });
        }
    </script>
}
